{
  "name": "meow-table",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names server,web \"npm run dev --workspace @meow-table/server\" \"npm run dev --workspace @meow-table/web\"",
    "check": "npm run check --workspaces",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace @meow-table/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3"
  }
}

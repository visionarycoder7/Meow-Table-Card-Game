{
  "name": "meow-table",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "backend",
    "frontend",
    "packages/protocol"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @meow-table/web",
    "check": "npm run types && npm run check --workspaces",
    "build": "npm run build --workspace @meow-table/web",
    "start": "npm run start --workspace @meow-table/web",
    "types": "wrangler types backend/worker-configuration.d.ts --config backend/wrangler.jsonc --include-runtime=false",
    "test": "node --test packages/protocol/src/index.test.ts backend/src/game.test.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "wrangler": "^4.165.0"
  }
}
